# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Databases & Private Stores (Never commit database files containing records)
*.db
*.sqlite
*.sqlite3
app/data/*.db

# Secrets & Environment variables (Never commit secret credentials)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key

# Frontend & Node
node_modules/
**/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Diagnostic & Scratch Scripts
scratch/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
