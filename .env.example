# FestivalFlow AI Environment Configuration
# Copy this file to .env and configure secrets for your deployment environment.
# DO NOT commit real credentials or private keys to source control.

# ==========================================
# 1. Server & Application Environment
# ==========================================
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8081
DEBUG=False

# ==========================================
# 2. Primary & Migration Databases
# ==========================================
# Default operational SQLite database (isolated and preserved)
DATABASE_PATH=app/data/festivalflow.db

# Optional MongoDB Connection (Unset by default; SQLite is used until tested and verified)
# Example: mongodb+srv://username:password@cluster.mongodb.net/festivalflow?retryWrites=true&w=majority
MONGODB_URI=

# ==========================================
# 3. Optional AI Generative Explanations (Backend Only)
# ==========================================
# Optional OpenRouter API Key for natural language operational briefings.
# System operates with transparent deterministic heuristics if key is unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# ==========================================
# 4. Weather Provider Configuration
# ==========================================
# Optional external weather provider. Set to false for standalone demo/manual baseline.
WEATHER_API_ENABLED=false
# Provider choice: open-meteo (no key needed), openweather (requires key), or manual
WEATHER_PROVIDER=open-meteo
# Optional OpenWeatherMap API Key (used when WEATHER_PROVIDER=openweather)
OPENWEATHER_API_KEY=

# ==========================================
# 5. Security & Session Secrets
# ==========================================
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
SESSION_EXPIRE_DAYS=7
PASSWORD_BCRYPT_ROUNDS=12

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:8081,http://127.0.0.1:8081
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:8081,http://127.0.0.1:8081

# Camera RTSP & Network Security
ALLOWED_CAMERA_DOMAINS=.festivaltransit.local
SSRF_PROTECTION_ENABLED=True

# Rate Limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECS=60
